# Aplicación
NODE_ENV=test
PORT=3000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=enterprise_auth_test
DB_SYNC=false
DB_LOGGING=false

# JWT (usado desde la Fase 4)
JWT_ACCESS_SECRET=__GENERAR_CON_COMANDO_ABAJO__
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=__GENERAR_CON_COMANDO_ABAJO__
JWT_REFRESH_EXPIRATION=7d

# Seguridad (usado desde la Fase 6)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
